{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bygglov-studieapp",
  "version": "0.1.0",
  "identifier": "se.bygglovstudieapp.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bygglov-studieapp – plugga till bygglovshandläggare",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Bygglov-studieapp",
    "category": "Education",
    "shortDescription": "Studieapp för blivande bygglovshandläggare",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Swedish"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sockulags/Bygglov-studieapp/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
