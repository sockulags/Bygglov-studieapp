{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window of Bygglov-studieapp.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "process:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.anthropic.com/*" }]
    }
  ]
}
